# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Free Neon Postgres connection string (stores push subscriptions)
DATABASE_URL=
# Any long random string; the free cron job calls /api/push/cron?secret=THIS
CRON_SECRET=
